
# Practical: Continuous Bag of Words (CBOW) Model

# Step 1: Import libraries

import numpy as np
import tensorflow as tf
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Embedding, Lambda, Dense
from tensorflow.keras.preprocessing.text import Tokenizer
from tensorflow.keras.preprocessing.sequence import pad_sequences


# Step 2: Sample text data

text = [
    "the cat sits on the mat",
    "the dog plays in the garden",
    "the cat plays with the dog",
    "the dog sits on the mat",
    "the cat sleeps on the sofa"
]


# Step 3: Tokenize the text

tokenizer = Tokenizer()
tokenizer.fit_on_texts(text)

sequences = tokenizer.texts_to_sequences(text)

word_index = tokenizer.word_index
vocab_size = len(word_index) + 1

print("Vocabulary:", word_index)
print("Vocabulary Size:", vocab_size)


# Step 4: Generate CBOW training data

window_size = 2

context_words = []
target_words = []

for sequence in sequences:

    for i in range(window_size, len(sequence) - window_size):

        context = (
            sequence[i-window_size:i] +
            sequence[i+1:i+window_size+1]
        )

        target = sequence[i]

        context_words.append(context)
        target_words.append(target)


X = np.array(context_words)
y = np.array(target_words)

print("\nContext Data:")
print(X)

print("\nTarget Data:")
print(y)


# Step 5: Build CBOW model

embedding_dim = 50

model = Sequential([
    Embedding(
        input_dim=vocab_size,
        output_dim=embedding_dim
    ),

    Lambda(lambda x: tf.reduce_mean(x, axis=1)),

    Dense(vocab_size, activation='softmax')
])


# Step 6: Compile model

model.compile(
    optimizer='adam',
    loss='sparse_categorical_crossentropy',
    metrics=['accuracy']
)


# Step 7: Display model summary

model.summary()


# Step 8: Train the model

model.fit(
    X,
    y,
    epochs=100,
    verbose=1
)


# Step 9: Predict target word

test_context = ["the", "cat", "on", "the"]

context_ids = [
    word_index[word] for word in test_context
    if word in word_index
]

input_data = np.array([context_ids])

prediction = model.predict(input_data, verbose=0)

predicted_id = np.argmax(prediction)

# Find predicted word

predicted_word = None

for word, index in word_index.items():
    if index == predicted_id:
        predicted_word = word
        break

print("\nContext Words:", test_context)
print("Predicted Word:", predicted_word)
