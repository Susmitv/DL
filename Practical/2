
import tensorflow as tf
from tensorflow import keras
import matplotlib.pyplot as plt
import pandas as pd
import numpy as np

# Load MNIST dataset from CSV files
train_data = pd.read_csv("MNIST/mnist_train.csv")
test_data = pd.read_csv("MNIST/mnist_test.csv")

# Separate images and labels
x_train = train_data.iloc[:, 1:].values
y_train = train_data.iloc[:, 0].values

x_test = test_data.iloc[:, 1:].values
y_test = test_data.iloc[:, 0].values

# Reshape images into 28x28
x_train = x_train.reshape(-1, 28, 28)
x_test = x_test.reshape(-1, 28, 28)

# Normalize data
x_train = x_train / 255.0
x_test = x_test / 255.0

# Create Feedforward Neural Network
model = keras.Sequential([
    keras.layers.Flatten(input_shape=(28, 28)),
    keras.layers.Dense(128, activation='relu'),
    keras.layers.Dense(10, activation='softmax')
])

# Compile model
model.compile(
    optimizer='adam',
    loss='sparse_categorical_crossentropy',
    metrics=['accuracy']
)

# Train model
model.fit(x_train, y_train, epochs=5)

# Evaluate model
loss, accuracy = model.evaluate(x_test, y_test)
print("Test Accuracy:", accuracy * 100, "%")

# Predict digit
prediction = model.predict(x_test[:1])
print("Predicted Digit:", prediction.argmax())

# Display image
plt.imshow(x_test[0], cmap='gray')
plt.title("Predicted Digit: " + str(prediction.argmax()))
plt.axis('off')
plt.show()
